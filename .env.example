# PostgreSQL connection for game saves. Only needed for persistence features;
# the case data, engines, and mock LLM provider all work without it.
DATABASE_URL=postgres://user:password@localhost:5432/coldcase

# "mock" (default) needs no key and runs deterministically.
# "openai-compatible" works with Ollama, LM Studio, vLLM, or OpenAI itself.
# "anthropic" uses the real Anthropic API and requires ANTHROPIC_API_KEY —
# without it, getLlmProvider() falls back to mock with a warning.
COLDCASE_LLM_PROVIDER=mock

# openai-compatible provider settings (only read when selected above):
# COLDCASE_OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama default
# COLDCASE_OPENAI_MODEL=llama3
# COLDCASE_OPENAI_API_KEY=                              # optional for local endpoints

# anthropic provider settings (only read when selected above):
# ANTHROPIC_API_KEY=
# COLDCASE_ANTHROPIC_MODEL=claude-3-5-haiku-latest
